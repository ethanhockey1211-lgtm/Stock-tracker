<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Tremor.Views"
       x:Class="Tremor.AppShell"
       Title="Tremor"
       FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Watchlist"
                      ContentTemplate="{DataTemplate views:WatchlistPage}"
                      Route="watchlist" />
        <ShellContent Title="Alerts"
                      ContentTemplate="{DataTemplate views:AlertsPage}"
                      Route="alerts" />
        <ShellContent Title="Listings"
                      ContentTemplate="{DataTemplate views:ListingsPage}"
                      Route="listings" />
        <ShellContent Title="Settings"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="settings" />
    </TabBar>

</Shell>
