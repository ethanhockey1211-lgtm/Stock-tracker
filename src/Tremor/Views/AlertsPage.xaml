<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tremor.ViewModels"
             xmlns:models="clr-namespace:Tremor.Core.Models;assembly=Tremor.Core"
             x:Class="Tremor.Views.AlertsPage"
             x:DataType="vm:AlertsViewModel"
             Title="Alerts">

    <Grid RowDefinitions="*,Auto" Padding="16" RowSpacing="8">

        <Label Grid.Row="0"
               Text="{Binding EmptyMessage}"
               Style="{StaticResource SecondaryLabel}"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"
               IsVisible="{Binding IsEmpty}" />

        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Alerts}"
                        IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBool}}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Alert">
                    <Border Style="{StaticResource Card}" Margin="0,4">
                        <Grid ColumnDefinitions="4,*" ColumnSpacing="12">
                            <BoxView Grid.Column="0"
                                     Color="{Binding Severity, Converter={StaticResource SeverityToColor}}"
                                     CornerRadius="2" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding Detail}" Style="{StaticResource SecondaryLabel}" />
                                <Label Text="{Binding DetectedUtc, StringFormat='{0:g} UTC'}"
                                       Style="{StaticResource SecondaryLabel}"
                                       FontSize="11" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Non-negotiable compliance footer -->
        <Label Grid.Row="1"
               Text="{Binding Disclaimer}"
               Style="{StaticResource SecondaryLabel}"
               FontSize="10"
               HorizontalTextAlignment="Center" />

    </Grid>
</ContentPage>
